{
  "manifest_version": 3,
  "name": "PrivacyLens",
  "version": "0.1.0",
  "description": "Analyze website privacy policies and terms in plain language with evidence-backed explanations.",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_title": "PrivacyLens — Policy Companion",
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/service-worker.js"
  }
}
